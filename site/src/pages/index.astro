.band-dark .earn{background:linear-gradient(160deg,rgba(255,255,255,.08),rgba(255,255,255,.02));border-color:rgba(255,255,255,.12);box-shadow:0 30px 60px -30px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.12)}
.band-dark .earn::before{opacity:.35}
.band-dark h2{color:#fff}
.band-dark .lede{color:#B0B4BA}
.band-dark .stack img{border-color:#1c1d21}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .band-frost::before{background:
  linear-gradient(180deg,rgba(24,25,27,.62),rgba(24,25,27,.55)),radial-gradient(38% 55% at 12% 35%,rgba(52,152,219,.28),transparent 70%),radial-gradient(40% 60% at 88% 70%,rgba(93,178,234,.2),transparent 70%),var(--slate-2);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.06),inset 0 -1px 0 var(--border)} }
:root[data-theme="dark"] .band-frost::before{background:
  linear-gradient(180deg,rgba(24,25,27,.62),rgba(24,25,27,.55)),radial-gradient(38% 55% at 12% 35%,rgba(52,152,219,.28),transparent 70%),radial-gradient(40% 60% at 88% 70%,rgba(93,178,234,.2),transparent 70%),var(--slate-2);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.06),inset 0 -1px 0 var(--border)}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .band-dark::before{filter:brightness(.8)} }
:root[data-theme="dark"] .band-dark::before{filter:brightness(.8)}
.ax-nm{font-size:10px;color:#2c3e50;margin-top:1px}
.ax-who{position:relative}.ax-done{margin-left:auto;font-size:8.5px;font-weight:700;color:#27ae60;background:#eafaf1;border-radius:999px;padding:2px 7px}
.ax-toast{font-size:9px}
.ax-toast{margin-top:4px!important}
.ax-poster{display:flex;align-items:center;gap:7px;padding:0 2px}.ax-poster img{width:24px;height:24px;border-radius:50%;object-fit:cover}
.ax-poster span{display:flex;flex-direction:column;line-height:1.2}.ax-poster b{font-size:10.5px;color:#2c3e50}.ax-poster em{font-style:normal;font-size:8.5px;color:#7f8c8d}
.ax-toast{align-self:center!important;white-space:nowrap;font-size:10px!important;padding:5px 14px!important}
/* app timer action bar: info · pause · live clock · finish · review */
.ax-bar{display:flex;align-items:center;justify-content:center;gap:7px;margin-top:6px}
.ax-cb{width:28px;height:28px;border-radius:50%;border:1.6px solid #2ecc71;display:grid;place-items:center;color:#2ecc71}
.ax-cb svg{width:13px;height:13px}
.ax-cb.blue{border-color:#3498db;color:#3498db}.ax-cb.orange{border-color:#f39c12;color:#f39c12}
.ax-cb.off{border-color:#bdc3c7;color:#bdc3c7}
.ax-tr{width:50px;height:50px;border-radius:50%;background:#2ecc71;display:grid;place-items:center;color:#fff;box-shadow:0 6px 14px -6px rgba(46,204,113,.8)}
.ax-tr svg{width:30px;height:30px;stroke-width:2.2;animation:axspin 6s linear infinite}
@keyframes axspin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.ax-tr svg{animation:none}}
.ax-state{font-size:11px;font-weight:600;color:#27ae60;margin-top:-2px}
/* nav: highlight the section in view */
.nav ul{gap:6px!important}
.nav ul a{display:block;padding:7px 12px;border-radius:999px;transition:color .2s,background .2s}
.nav ul a.on{color:var(--ink);background:var(--muted);font-weight:500}
.nav ul a.on::after{content:"";display:block;height:2px;width:14px;margin:3px auto -5px;border-radius:2px;background:var(--saffron)}
section[id]{scroll-margin-top:96px}
/* hero headline: calmer size; longest skill still fits on one line */
.hero h1{font-size:clamp(36px,5.4vw,78px)!important;letter-spacing:-.04em}
@media (max-width:720px){ .hero h1{font-size:clamp(34px,10vw,52px)!important} }
/* member stories */
.stories{grid-template-columns:repeat(3,minmax(0,1fr))!important}
.story .art{height:220px}
.story .art img{width:128px;height:128px}
.story h3{font-size:22px!important}
.schips{display:flex;flex-wrap:wrap;gap:6px;margin:4px 0 6px}
.schip{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;padding:5px 10px;border-radius:999px;background:var(--muted);color:var(--ink)}
.schip{white-space:nowrap;flex-direction:row!important}.schip>svg{display:block}.schip svg{width:13px;height:13px;flex:none}
.schip.time{background:var(--red-3);color:var(--red-11)}.schip.plan{background:#fff7c2;color:#946800}.schip.cash,.schip.save{background:var(--blue-3);color:var(--blue-11)}
.readmore{align-self:flex-start;margin-top:auto;background:none;border:0;padding:0;font:600 14px var(--body);color:var(--ink);cursor:pointer}
.readmore:hover{color:var(--saffron)}
.story-dlg{width:min(640px,calc(100% - 32px));max-height:calc(100vh - 48px);overflow:auto}
.story-dlg h3{font-size:28px;margin:10px 0 16px}
.story-dlg p{color:var(--mist);margin:0 0 12px;line-height:1.65}
.sppl{display:flex;align-items:flex-start;gap:10px;flex-wrap:wrap;margin:0 0 18px}
.sp{display:flex;flex-direction:column;align-items:center;gap:4px;width:104px;text-align:center}
.sp img{width:64px;height:64px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 2px var(--saffron)}
.sp b{font-size:13px;line-height:1.2}.sp small{font-size:11px;color:var(--mist)}
.sarrow{color:var(--mist);margin-top:22px}
.snote{font-size:12px!important;margin-top:8px!important}
@media (max-width:860px){ .stories{grid-template-columns:minmax(0,1fr)!important} }
@media (max-width:1100px){ .stories{grid-template-columns:minmax(0,1fr)!important} }
/* story tags: outlined, ink colour, small */
.schip,.schip.time,.schip.plan,.schip.cash,.schip.save{background:transparent!important;color:var(--ink)!important;border:1px solid var(--ink);font-size:11px!important;font-weight:500!important;padding:3px 9px!important;gap:4px!important}
.schip svg{width:11px!important;height:11px!important}
/* story scenes: real photo behind translucent glass portraits */
.story .art.photo{background:var(--bg) center/cover no-repeat}
.story .art.photo::before{content:"";position:absolute;inset:0;width:auto;height:auto;border-radius:0;filter:none;opacity:1;top:0;
  background:linear-gradient(180deg,rgba(0,0,0,.05) 0%,rgba(0,0,0,.12) 55%,rgba(0,0,0,.35) 100%)}
.story .art.photo img,.sp img{background:rgba(255,255,255,.28)!important;-webkit-backdrop-filter:blur(14px) saturate(150%);backdrop-filter:blur(14px) saturate(150%);
  border:2px solid rgba(255,255,255,.75)!important;box-shadow:0 10px 24px -10px rgba(0,0,0,.45);object-fit:cover;object-position:50% 20%}
.sp img{background:rgba(52,152,219,.14)!important;border:2px solid var(--saffron)!important;box-shadow:none}
.story .txt > p{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;line-clamp:3;overflow:hidden}
.ill{position:absolute;z-index:2;top:10px;right:10px;font-size:10px;font-weight:600;letter-spacing:.04em;color:#fff;background:rgba(0,0,0,.45);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.35);border-radius:999px;padding:3px 9px}
</style>
<script is:inline>
(function(){ var saved=null; try{ saved=localStorage.getItem("tx-theme"); }catch(e){}
  if(saved==="light"||saved==="dark") document.documentElement.setAttribute("data-theme",saved); })();
</script>
