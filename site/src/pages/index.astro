footer nav{display:flex;gap:22px;flex-wrap:wrap}
footer .wrap{align-items:center}


/* chain + ledger */
.tabs{display:inline-flex;gap:4px;padding:4px;border-radius:999px;margin-bottom:16px;max-width:100%;overflow-x:auto}
.tabs button{border:0;background:transparent;color:var(--mist);font:700 14px/1 var(--body);padding:11px 18px;border-radius:999px;cursor:pointer;white-space:nowrap}
.tabs button[aria-selected="true"]{background:var(--ink);color:var(--night)}
.tabs button:hover{color:var(--ink)}.tabs button[aria-selected="true"]:hover{color:var(--night)}
.task{display:block;font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:var(--saffron);margin-bottom:2px}
.chain{padding:26px 28px 30px}
.chain-head{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:22px}
.tag{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--mist)}
.hint{font-size:14px;color:var(--mist)}
.chain-row{display:flex;align-items:flex-start;gap:0}
.node{flex:none;width:112px;text-align:center}
.node img{width:76px;height:76px;border-radius:50%;margin:0 auto 10px;background:var(--disc);border:3px solid var(--ring)}
.node b{display:flex;align-items:flex-start;justify-content:center;min-height:2.6em;font-size:14px;font-weight:700;line-height:1.3}
.bal{margin:10px auto 0;padding:8px 8px 9px;border-radius:var(--radius-lg);display:grid;justify-items:center;gap:1px;min-width:92px;position:relative}
.bal .lbl{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--mist);font-weight:700}
.bal .val{font:800 20px/1.2 var(--body);letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.delta{position:absolute;right:-6px;top:-10px;font:700 12px/1 var(--body);padding:4px 7px;border-radius:999px;opacity:0;transform:translateY(4px);transition:opacity .3s ease,transform .3s ease;pointer-events:none}
.delta.show{opacity:1;transform:none}
.delta.up{background:var(--up);color:#fff}.delta.down{background:var(--time-deep);color:#fff}
.link{flex:1;min-width:0;padding-top:20px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:8px}
.wire{position:relative;width:100%;height:2px;background:var(--line2);border-radius:2px;margin-top:16px}
.wire::after{content:"";position:absolute;right:-1px;top:-4px;border:5px solid transparent;border-left:7px solid var(--edge)}
.wire i{position:absolute;left:0;top:-4px;width:10px;height:10px;border-radius:50%;background:var(--saffron);box-shadow:0 0 14px var(--saffron);opacity:0}
.link.on .wire{background:linear-gradient(90deg,rgba(245,10,10,.2),var(--saffron))}
.link.on .wire i{animation:run 1.5s ease-in-out forwards}
@keyframes run{0%{left:0;opacity:0}15%{opacity:1}85%{opacity:1}100%{left:calc(100% - 10px);opacity:0}}
.pay-chip{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;transition:transform .3s ease}
.link.on .pay-chip{transform:scale(1.08)}
.link small{font-size:14px;color:var(--mist);line-height:1.35}
.cash{display:inline-flex;align-items:center;padding:5px 10px;border-radius:999px;font:600 12px/1 var(--body);color:#fff;background:linear-gradient(160deg,#5DB2EA,#1F6FB2)}
.payways{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:18px 0}
.pay{display:flex;align-items:flex-start;gap:10px;padding:22px 24px;flex-wrap:wrap}
.pay div{flex:1 1 240px}
.pay b{font-weight:600}.pay p{margin:4px 0 0;color:var(--mist);font-size:14px}
.ledger{padding:8px 0;overflow-x:auto}
.lrow{display:grid;grid-template-columns:1.5fr 1.1fr 1.1fr .9fr;gap:16px;align-items:center;padding:14px 26px;border-top:1px solid var(--edge-soft);min-width:680px}
.lrow.lhead{border-top:0;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--mist);padding-bottom:6px}
.lrow .what{font-weight:500}
.who{display:flex;align-items:center;gap:10px;color:var(--mist);font-size:14px}
.who img{width:34px;height:34px;border-radius:50%;background:var(--disc)}
.paid{display:flex;gap:6px;flex-wrap:wrap}
@media (max-width:980px){
  .chain-row{flex-direction:column;align-items:stretch}
  .node{width:auto;display:flex;align-items:center;gap:14px;text-align:left}.node img{margin:0;width:56px;height:56px}
  .ntxt{display:flex;align-items:center;justify-content:space-between;gap:12px;flex:1}.bal{margin:0}.node b{min-height:0;justify-content:flex-start}
  .link{flex-direction:row;padding:6px 0 6px 26px;text-align:left;gap:12px}
  .wire{width:2px;height:44px;margin:0}.wire::after{display:none}
  .link.on .wire{background:linear-gradient(180deg,rgba(245,10,10,.2),var(--saffron))}
  @keyframes run{0%{top:0;left:-4px;opacity:0}15%{opacity:1}85%{opacity:1}100%{top:34px;left:-4px;opacity:0}}
  .payways{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){.link.on .wire i{animation:none;opacity:1;left:calc(50% - 5px)}}

@media (max-width:620px){
  .ledger{overflow:visible}
  .lrow{min-width:0;grid-template-columns:1fr auto;grid-template-areas:"what paid" "pro pro" "req req";row-gap:8px;padding:16px 18px}
  .lrow.lhead{display:none}
  .lrow .what{grid-area:what}.lrow .paid{grid-area:paid;justify-content:flex-end}
  .lrow .pro{grid-area:pro}.lrow .req{grid-area:req}
  .who::before{content:attr(data-l);width:28px;font-size:12px;color:var(--mist)}
  .who img{width:28px;height:28px}
}
