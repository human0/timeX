---
import { loadCatalog, formatHours, categoryTitle } from '../lib/catalog';
import PrivacyPolicy from '../components/PrivacyPolicy.astro';
import TermsOfUse from '../components/TermsOfUse.astro';

// Read-only data from the server (GET /public/catalog), fetched once at build time.
const catalog = await loadCatalog();
const statusLabel = (id: string) => catalog.statuses.find((s) => s.id === id)?.label ?? id;
const byCategory = catalog.categories.map((category) => ({
  category,
  services: catalog.services.filter((s) => s.category === category),
}));
const popular = catalog.services.slice(0, 5);
const fmt = (n: number) => n.toLocaleString('en-US');
const stats = catalog.stats ?? { secondsExchanged: null, ratings: null, professions: null, cities: null };
const heroStats = [
  // Sent in seconds; shown as whole hours, once there is at least an hour.
  stats.secondsExchanged != null && stats.secondsExchanged >= 3600
    ? { value: `${fmt(Math.floor(stats.secondsExchanged / 3600))}+h`, label: 'time traded' }
    : null,
  stats.ratings ? { value: stats.ratings.average.toFixed(1), label: 'average rating' } : null,
  stats.professions != null ? { value: `${fmt(stats.professions)}+`, label: 'professions' } : null,
  stats.cities != null ? { value: `${fmt(stats.cities)}+`, label: 'cities' } : null,
].filter((x): x is { value: string; label: string } => x !== null);
