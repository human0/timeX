.fstores{display:flex;gap:10px;flex-wrap:wrap}
.sbadge{display:inline-flex;align-items:center;gap:8px;padding:7px 14px 7px 11px;border:1px solid var(--border);border-radius:var(--radius-md);text-decoration:none;color:var(--ink);background:var(--card);transition:border-color .15s}
.sbadge:hover{border-color:var(--slate-8)}
.sbadge svg{width:20px;height:20px}.sbadge span{display:flex;flex-direction:column;font-weight:600;font-size:14px;line-height:1.15}.sbadge small{font-size:11px;font-weight:400;color:var(--mist)}
.fcol{display:flex;flex-direction:column;gap:12px}
.fcol h4{margin:0 0 4px;font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--ink)}
.fcol a{color:var(--mist);text-decoration:none;font-size:14px;width:fit-content}
.fcol a:hover{color:var(--ink)}
footer .wrap.fbottom{display:flex;justify-content:space-between;gap:12px 24px;flex-wrap:wrap;padding:20px 32px 28px;border-top:1px solid var(--border);font-size:12px;color:var(--mist)}
@media (max-width:980px){ footer .wrap.fgrid{grid-template-columns:1fr 1fr 1fr} .fbrand{grid-column:1/-1} .faq-intro{position:static} }
@media (max-width:620px){ footer .wrap.fgrid{grid-template-columns:1fr 1fr;padding:0 16px 40px} footer .wrap.fbottom{padding:20px 16px 96px;flex-direction:column} .acc{padding:0 18px} .acc .ans p{padding-right:0} }
.acc details[open] summary::after,.acc summary::after{content:none;display:none}
/* FAQ fixes + question form */
.faq-intro h2{margin-bottom:0}
.ask-q{display:flex;flex-direction:column;gap:8px;padding:20px;margin-top:28px;border-radius:var(--radius-lg);box-shadow:none}
.aq-head{display:flex;gap:14px;margin-bottom:8px}.aq-head b{font-size:16px}.aq-head p{margin:2px 0 0;color:var(--mist);font-size:14px;line-height:1.5}
.ask-q label{font-size:14px;font-weight:600;margin-top:4px}
.ask-q textarea,.ask-q input{width:100%;font:400 16px/1.5 var(--body);color:var(--ink);background:var(--card);border:1px solid var(--input);border-radius:var(--radius-md);padding:10px 12px;resize:vertical;transition:border-color .15s,box-shadow .15s}
.ask-q textarea{min-height:104px}
.ask-q textarea::placeholder,.ask-q input::placeholder{color:var(--slate-9)}
.ask-q textarea:focus,.ask-q input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px var(--red-3)}
.ask-q [aria-invalid="true"]{border-color:var(--red-11)}
.aq-foot{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:8px;flex-wrap:wrap}
.aq-foot small{color:var(--mist);font-size:12px;max-width:30ch;line-height:1.4}
.ftag{font:700 24px/1.2 var(--display);letter-spacing:-.02em;color:var(--ink)!important;max-width:16ch!important}
.ftag em{font-style:normal;color:var(--primary)}
@media (max-width:980px){ .faq{grid-template-columns:minmax(0,1fr);gap:28px} .faq-intro{position:static} }
.cta.start{justify-content:flex-start;margin-top:32px}
.story h3{line-height:1.2}.story .cat{line-height:1.5}
footer .wrap.fbottom{border-top:0;position:relative}footer .wrap.fbottom::before{content:"";position:absolute;left:32px;right:32px;top:0;border-top:1px solid var(--border)}
@media (max-width:620px){footer .wrap.fbottom::before{left:16px;right:16px}}
.faq-top{margin-bottom:32px}.faq-top .lede{font-size:16px;margin-top:12px}
.faq{grid-template-columns:minmax(0,1.6fr) minmax(0,1fr)!important;gap:28px!important;align-items:start}
.faq-side{position:sticky;top:110px}.faq-side .ask-q{margin-top:0}
@media (max-width:980px){ .faq{grid-template-columns:minmax(0,1fr)!important} .faq-side{position:static} }
@media (max-width:620px){ #chainTabs{max-width:100%;overflow-x:auto;scrollbar-width:none} #chainTabs button{flex:none} }
/* photo-realistic portraits */
.member img,.node img,.chip img,.stack img,.who2 img{object-fit:cover;object-position:50% 35%}
.story .art.fl3d img{object-fit:contain;padding:10px;background:var(--disc)}
.story .art img{object-fit:cover;object-position:50% 35%}
/* task label sits above the arrow */
.link{padding-top:0;gap:6px}
.link small{height:78px;display:flex;flex-direction:column;justify-content:flex-end;font-size:14px;line-height:1.3}
.link .wire{margin-top:0}
@media (max-width:720px){ .link small{height:auto;min-height:0;order:2} .link .wire{order:0} .link .pay-chip{order:1} }
/* app-accurate phone screens (Time X app: theme.ts colours, system font) */
.phone.ax{width:236px;height:480px;padding:7px;border-radius:38px;background:#111;box-shadow:var(--shadow),inset 0 0 0 1.5px #333}
.phone.ax .scr{position:relative;border-radius:31px;background:#f5f7fa;padding:0;gap:0;color:#2c3e50;font-family:-apple-system,"SF Pro Text","Segoe UI",Roboto,sans-serif;display:flex;flex-direction:column;overflow:hidden}
.ax svg{width:14px;height:14px;flex:none}
.ax-status{display:flex;justify-content:space-between;align-items:center;padding:10px 18px 2px;font-size:11px;color:#2c3e50}
.ax-status span{display:flex;gap:3px}.ax-status svg{width:12px;height:12px}
.ax-head{display:flex;align-items:center;justify-content:space-between;padding:6px 10px 8px}
.ax-head h4{margin:0;font-size:16px;font-weight:700;color:#3498db;letter-spacing:0}
.ax-ic{width:26px;height:26px;display:grid;place-items:center;color:#3498db}.ax-ic.ax-ring{border:1.5px solid #3498db;border-radius:50%}
.ax-body{flex:1;padding:0 10px 10px;display:flex;flex-direction:column;gap:7px;min-height:0}
.ax-seg{display:flex;background:#fff;border:1px solid #e9ecef;border-radius:10px;padding:3px;gap:3px}
.ax-seg span{flex:1;text-align:center;font-size:10.5px;font-weight:600;color:#7f8c8d;padding:5px 0;border-radius:8px;display:flex;justify-content:center;align-items:center;gap:4px}
.ax-seg span.on{background:#3498db;color:#fff}
.ax-seg i{font-style:normal;font-size:9px;min-width:14px;height:14px;border-radius:7px;display:inline-grid;place-items:center;background:rgba(255,255,255,.25);border:1px solid currentColor}
.ax-card{background:#fff;border-radius:12px;padding:8px 10px;display:flex;flex-direction:column;gap:2px;box-shadow:0 1px 3px rgba(0,0,0,.06)}
.ax-card small{font-size:9.5px;color:#95a5a6;text-transform:none;letter-spacing:0}
.ax-card b{font-size:12px;font-weight:600;color:#2c3e50}
.ax-card em{font-style:normal;font-size:9.5px;color:#7f8c8d}
.ax-time{display:flex;align-items:center;gap:5px}.ax-time svg{color:#3498db;width:12px;height:12px}
.ax-tags{display:flex;gap:4px;flex-wrap:wrap;margin-top:2px}.ax-tags i{font-style:normal;font-size:9.5px;font-weight:600;color:#fff;background:#3498db;border-radius:15px;padding:2px 8px}
.ax-btn{margin-top:auto;text-align:center;font-size:12px;font-weight:700;color:#fff;background:#3498db;border-radius:12px;padding:10px}
.ax-btn.green{background:#2ecc71;margin-top:6px}
.ax-timer{align-items:center;text-align:center;gap:6px}
.ax-job{font-size:14px;font-weight:700;color:#2c3e50;margin-top:2px}
.ax-duo{display:flex;align-items:center;gap:8px}.ax-duo span{display:flex;flex-direction:column;align-items:center;gap:3px}
.ax-duo img{width:44px;height:44px;border-radius:50%;border:2px solid #3498db;object-fit:cover}
.ax-duo small{font-size:8.5px;color:#7f8c8d}.ax-duo em{color:#3498db;margin-top:-12px}
.ax-lbl{font-size:10px;color:#34495e;margin-top:4px}
.ax-big{display:flex;align-items:center;gap:4px;font-size:20px;font-weight:800;color:#2c3e50;letter-spacing:-.01em;font-variant-numeric:tabular-nums}.ax-big svg{width:14px;height:14px}
.ax-rem{font-size:9.5px;color:#34495e}.ax-rem b{font-weight:700}
.ax-det{width:100%;background:#e9ecef;border-radius:10px;padding:8px 10px;display:flex;flex-direction:column;gap:5px;text-align:left;margin-top:4px}
.ax-det span{display:flex;align-items:center;gap:6px;font-size:9.5px;color:#7f8c8d}.ax-det svg{width:11px;height:11px}
.ax-wallet{background:#3498db;color:#fff;border-radius:12px;padding:10px 12px;display:flex;flex-direction:column;align-items:center;gap:4px}
.ax-wh{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700}.ax-wallet>i{display:block;width:100%;height:1px;background:rgba(255,255,255,.35);margin:2px 0}
.ax-wallet small{font-size:8.5px;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.85)}
.ax-wv{display:flex;align-items:center;gap:5px;font-size:19px;font-weight:800}
.ax-item{gap:4px}.ax-who{display:flex;align-items:center;gap:7px}.ax-who img{width:26px;height:26px;border-radius:50%;object-fit:cover}
.ax-who span{display:flex;flex-direction:column;line-height:1.15}.ax-who b{font-size:10.5px}.ax-who em{font-size:9px;color:#f4c430}
.ax-meta{display:flex;align-items:center;gap:4px;font-size:9.5px;color:#7f8c8d}.ax-meta svg{width:10px;height:10px;color:#3498db}
.ax-toast{margin-top:auto;align-self:center;font-size:10px;font-weight:600;color:#fff;background:#27ae60;border-radius:999px;padding:5px 12px;box-shadow:0 4px 10px rgba(39,174,96,.3)}
.ax-tabs{display:flex;justify-content:space-around;background:#fff;border-top:1px solid #e9ecef;padding:7px 4px 12px}
.ax-tabs span{display:flex;flex-direction:column;align-items:center;gap:2px;font-size:8.5px;color:#95a5a6}.ax-tabs svg{width:15px;height:15px}
.ax-tabs span.on{color:#3498db;font-weight:600}
.ax-head{display:grid!important;grid-template-columns:26px 1fr 26px;align-items:center}.ax-head h4{text-align:center}.ax-head .ax-ic:empty{visibility:hidden;display:block}
.hero-stats{margin-top:28px;gap:12px;grid-template-columns:repeat(3,minmax(0,1fr))!important}
.hero-stats .stat{padding:14px 16px;border-radius:var(--radius-lg)}
.hero-stats .stat b{font-size:24px;line-height:1.1}
.hero-stats .stat span{font-size:12px;line-height:1.3}
/* How it works: glass cards like the rest of the site, Time X blue as the accent */
.hw-steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.hw-step{position:relative;display:flex;flex-direction:column;padding:14px 14px 24px;border:1px solid var(--border);border-radius:var(--radius-xl);background:var(--glass-strong);-webkit-backdrop-filter:blur(24px) saturate(160%);backdrop-filter:blur(24px) saturate(160%);box-shadow:var(--shadow)}
.hw-stage{position:relative;height:400px;overflow:hidden;display:flex;justify-content:center;padding-top:28px;border-radius:var(--radius-lg);
  background:radial-gradient(70% 60% at 50% 100%,rgba(52,152,219,.35),transparent 70%),linear-gradient(180deg,var(--blue-3),var(--card))}
.hw-stage::after{content:"";position:absolute;left:0;right:0;bottom:0;height:56px;background:linear-gradient(180deg,transparent,var(--card));pointer-events:none}
.hw-stage .phone.ax{margin:0;flex:none;box-shadow:0 24px 48px -20px rgba(23,79,134,.45),inset 0 0 0 1.5px #333}
.hw-stage .scr{text-align:left}
.hw-meta{display:flex;gap:14px;align-items:flex-start;padding:20px 10px 0}
.hw-n{flex:none;width:36px;height:36px;border-radius:50%;display:grid;place-items:center;font:700 15px/1 var(--display);color:#fff;background:var(--sage);box-shadow:0 0 0 5px var(--blue-3)}
.hw-step h3{margin:6px 0 4px;font-size:18px;font-weight:600;letter-spacing:-.01em}
.hw-step p{margin:0;color:var(--mist);font-size:15px;line-height:1.5}
@media (max-width:980px){ .hw-steps{grid-template-columns:minmax(0,1fr)} .hw-stage{height:380px} }
.hw-go{display:flex;justify-content:center;margin-top:36px}
.btn.hw-start{background:#3498DB;color:#fff;padding:15px 28px;font-size:16px;box-shadow:0 12px 28px -12px rgba(52,152,219,.7)}
.btn.hw-start:hover{background:#2980B9}
.btn.hw-start svg{width:18px;height:18px;transition:transform .2s}.btn.hw-start:hover svg{transform:translateX(3px)}
/* footer tagline on one line when there is room */
.ftag{max-width:none!important;font-size:18px!important;letter-spacing:-.01em!important;margin:14px 0 18px!important}
@media (min-width:1100px){ footer .wrap.fgrid{grid-template-columns:minmax(0,2.3fr) repeat(3,minmax(0,1fr))} .ftag{white-space:nowrap} }
/* ---------- section materials ---------- */
.fields{position:absolute;height:115vh;-webkit-mask-image:linear-gradient(#000 60%,transparent);mask-image:linear-gradient(#000 60%,transparent)}
.fields i:nth-child(3){left:38vw;top:18vh;width:34vw;height:34vw;background:radial-gradient(circle,#8B5CF6,transparent 65%);opacity:calc(var(--field-op)*.7)}
.fields i:nth-child(4){display:none}
.band{position:relative;isolation:isolate}
.band::before{content:"";position:absolute;z-index:-1;top:0;bottom:0;left:50%;width:100vw;transform:translateX(-50%);pointer-events:none}
.band-frost::before{background:
  linear-gradient(180deg,rgba(255,255,255,.42),rgba(255,255,255,.3)),
  radial-gradient(42% 60% at 10% 30%,rgba(52,152,219,.45),transparent 72%),
  radial-gradient(45% 65% at 90% 75%,rgba(93,178,234,.42),transparent 72%),
  radial-gradient(30% 40% at 55% 0%,rgba(139,92,246,.16),transparent 70%),
  var(--slate-2);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.9),inset 0 -1px 0 var(--border)}
