const q = (A,C,B,t) => ({x:(1-t)*(1-t)*A.x+2*(1-t)*t*C.x+t*t*B.x, y:(1-t)*(1-t)*A.y+2*(1-t)*t*C.y+t*t*B.y});
function spawn(delay, staticT, forceKind){
  const k = Math.floor(Math.random()*edges.length); let [a,b] = edges[k]; if (Math.random()<.5) [a,b]=[b,a];
  const A=nodes[a],B=nodes[b],C=ctrl(A,B), p = pathEls[k];
  const kind = forceKind || pick(); const label = kind.labels[Math.floor(Math.random()*kind.labels.length)];
  const t = document.createElement("div"); t.className = "token " + kind.k; t.innerHTML = icons[kind.k] + label; orbit.appendChild(t);
  const place = u => { const P=q(A,C,B,u); const w=orbit.clientWidth, h=orbit.clientHeight; t.style.transform=`translate(${P.x/100*w - t.offsetWidth/2}px,${P.y/100*h - t.offsetHeight/2}px)`; };
  p.classList.add("hot", kind.k);
  if (staticT !== undefined){ place(staticT); return; }
  const dur = 2800 + Math.random()*900; let start;
  const step = ts => { if(!start) start = ts + delay; const u = Math.min(1, Math.max(0,(ts-start)/dur)); const e = u<.5 ? 2*u*u : 1-Math.pow(-2*u+2,2)/2; place(e); t.style.opacity = u<.08 ? u/.08 : u>.92 ? (1-u)/.08 : 1;
    if (u<1) requestAnimationFrame(step); else { t.remove(); p.classList.remove("hot","time","cash","gift"); B.el.classList.add("got"); setTimeout(()=>B.el.classList.remove("got"),450); if (running) spawn(200+Math.random()*900); } };
  requestAnimationFrame(step);
}
let running = !reduce;
if (reduce) { spawn(0,.35,kinds[0]); spawn(0,.55,kinds[1]); spawn(0,.45,kinds[2]); spawn(0,.6,kinds[0]); }
else {
  [[0,kinds[0]],[600,kinds[1]],[1200,kinds[0]],[1800,kinds[2]],[2400,kinds[0]]].forEach(([d,k]) => spawn(d,undefined,k));
  new IntersectionObserver(es => es.forEach(e => { const was = running; running = e.isIntersecting && !reduce; if (running && !was && !orbit.querySelector('.token')) [0,600,1200].forEach(d => spawn(d)); })).observe(orbit);
}

/* FAQ question form: opens the visitor's email app with the question filled in */
(() => { const f = document.getElementById("askQ"); if (!f) return;
  const q = document.getElementById("aqText"), em = document.getElementById("aqEmail"), msg = document.getElementById("aqMsg");
  f.addEventListener("submit", e => { e.preventDefault();
    q.removeAttribute("aria-invalid"); em.removeAttribute("aria-invalid");
    if (!q.value.trim()) { q.setAttribute("aria-invalid","true"); msg.textContent = "Type your question first."; q.focus(); return; }
    if (!em.checkValidity()) { em.setAttribute("aria-invalid","true"); msg.textContent = "Add an email address so we can reply."; em.focus(); return; }
    const body = q.value.trim() + "\n\nReply to: " + em.value.trim();
    location.href = "mailto:support@timexchange.co.za?subject=" + encodeURIComponent("Question from the website") + "&body=" + encodeURIComponent(body);
    msg.textContent = "Your email app should open with the question ready to send."; });
})();

/* nav: mark the section currently in view */
(() => { const links = [...document.querySelectorAll("#navLinks a")]; if (!links.length || !("IntersectionObserver" in window)) return;
  const map = new Map(links.map(a => [a.getAttribute("href").slice(1), a]));
  const vis = new Map();
  const io = new IntersectionObserver(es => { es.forEach(e => vis.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0));
    let best = null, br = 0; vis.forEach((r, id) => { if (r > br) { br = r; best = id; } });
    links.forEach(a => { const on = best && a === map.get(best); a.classList.toggle("on", !!on); if (on) a.setAttribute("aria-current", "true"); else a.removeAttribute("aria-current"); });
  }, { rootMargin: "-35% 0px -55% 0px", threshold: [0, .01, .25, .5, 1] });
  map.forEach((a, id) => { const s = document.getElementById(id); if (s) io.observe(s); });
})();

/* booking timer on the How it works screen: time spent counts up, remaining counts down */
(() => { const sp = document.getElementById("axSpent"), lf = document.getElementById("axLeft"); if (!sp || !lf) return;
  const total = 2*3600, start = 1*3600 + 42*60 + 18; let s = start;
  const f = n => { const h = Math.floor(n/3600), m = Math.floor(n%3600/60), x = n%60; return String(h).padStart(2,"0")+"h "+String(m).padStart(2,"0")+"m "+String(x).padStart(2,"0")+"s"; };
  setInterval(() => { s = s >= total ? start : s + 1; sp.textContent = f(s); lf.textContent = f(total - s); }, 1000);
})();
</script>
<script is:inline>
(function(){
  var archived = {about:1, 'job-hunt':1, 'job-hunt-offers':1, 'career-help':1, 'book-consultation':1, subscription:1};
  var pages = {'privacy-policy':'/privacy/', 'policies':'/privacy/', 'terms-of-service':'/terms/', 'auto-renewable-subscriptions':'/terms/#auto-renewable-subscriptions'};
  var h = location.hash.slice(1);
  if (pages[h]) location.replace(pages[h]);
  else if (archived[h]) location.replace('/legacy/#' + h);
})();
</script>
