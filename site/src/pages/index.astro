<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style is:global>
[hidden]{display:none!important}
.hero-stats.n4{grid-template-columns:repeat(4,minmax(0,1fr))!important}
.legal-wrap{max-width:820px;margin:0 auto}
.legal{padding:8px 0 40px}
.legal h2{font-size:clamp(28px,4vw,40px);margin:0 0 6px;color:var(--ink)}
.legal h3{font-size:20px;margin:32px 0 8px;color:var(--ink)}
.legal h4{font-size:16px;margin:20px 0 6px;color:var(--ink)}
.legal p,.legal li{font-size:15px;color:var(--mist);line-height:1.6}
.legal ul{padding-left:20px}
.legal-date{font-size:13px}
.legal a{color:var(--indigo)}
.legal-band + .legal-band{padding-top:0}
.states-block{margin-top:32px}
.states-h{margin:0 0 12px;font-size:14px;font-weight:600;color:var(--mist)}
.states{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.state{padding:14px 16px;border-radius:var(--radius-lg)}
.state b{display:block;font-weight:700;font-size:15px}
